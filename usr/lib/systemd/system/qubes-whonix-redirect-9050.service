[Unit]
Description=redirect 127.0.0.1:9050 to Whonix-Gateway in Qubes TemplateVM service
Documentation=https://github.com/Whonix/qubes-whonix
ConditionPathExists=/run/qubes/this-is-templatevm
After=qubes-sysinit.service
After=qubes-whonix-redirect-9050.socket
Requires=qubes-whonix-redirect-9050.socket

[Service]
## IP HARDCODED but only used in Qubes-Whonix. Not used in Non-Qubes-Whonix.
ExecStart=/usr/lib/systemd/systemd-socket-proxyd 10.152.152.10:9050
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

## W^X hardening. systemd-socket-proxyd is a tiny upstream C socket forwarder
## (no JIT, writes nothing). MemoryDenyWriteExecute denies anon W+X / mprotect/
## shmat gaining PROT_EXEC; SystemCallArchitectures=native closes the secondary-
## ABI bypass; LockPersonality blocks READ_IMPLIES_EXEC; ~memfd_create kills the
## memfd bypass; ProtectSystem=strict + ProtectHome + NoExecPaths close the
## file-backed vector near-completely for this write-nothing proxy.
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
LockPersonality=yes
SystemCallFilter=~memfd_create
NoExecPaths=/run /tmp /var/tmp /dev/shm /dev

## Defense-in-depth (separate axis from W^X): NoNewPrivileges blocks this
## daemon from gaining privileges (setuid/setgid, file capabilities, AppArmor
## non-subset Px). systemd-socket-proxyd gains no privilege.
NoNewPrivileges=yes
